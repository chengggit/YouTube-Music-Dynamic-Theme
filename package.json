{
  "type": "module",
  "devDependencies": {
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-rics": "^0.3.17"
  },
  "scripts": {
    "build": "npm run build-rics && npm run build-pear",
    "dev": "node build-rics.js --watch --dev",
    "format": "prettier --write src/ style.rics pear-ytm.css",
    "build-rics": "node build-rics.js",
    "watch-rics": "node build-rics.js --watch",
    "build-pear": "postcss src/index.css --use postcss-import -o pear-ytm.css --no-map",
    "watch-pear": "postcss src/index.css --use postcss-import -o pear-ytm.css --no-map --watch"
  }
}
