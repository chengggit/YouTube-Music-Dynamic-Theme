/* ========================== BETTER LYRICS ========================== */
#better-lyrics-kawarp-backdrop-player {
  background-color: transparent !important;
}

#blyrics-loader {
  transition: height 0.5s ease-in-out, opacity 0.5s ease-in-out, padding-top 0.5s ease-in-out;
}

#blyrics-song-info {
  max-width: 50rem;
}

@if $fullscreen-layout == corner {
  #blyrics-fs-info-row {
    text-align: left !important;
    margin: 0 !important;
    padding-left: 2rem !important;
  }
  #blyrics-fs-controls {
    padding-left: 2rem;
  }
}

@if $new-control-is-enable {
  ytmusic-player-bar.ytmusic-app[player-page-open][player-fullscreened] {
    display: none;
  }
  #layout[player-fullscreened]:not([blyrics-dfs])[show-fullscreen-controls] .blyrics-dock[data-position^="bottom-"] {
    --dock-y-shift: 0;
  }
} @else {
  #blyrics-fs-controls,
  .blyrics-fs-info-actions {
    display: none;
  }
  @if $fullscreen-layout == center {
    #blyrics-fs-column #blyrics-song-info {
      text-align: center !important;
    }
  }
}

@if $new-control-is-enable and not $new-control-always-on {
  #blyrics-fs-controls {
    transform: translateY(0rem);
    opacity: 1;
  }

  ytmusic-app-layout[cursor-hidden] .blyrics-fs-info-actions,
  ytmusic-app-layout[cursor-hidden] #blyrics-fs-controls {
    transform: translateY(10rem);
    opacity: 0;
  }
  @if $fullscreen-layout == corner {
    ytmusic-app-layout[cursor-hidden] #blyrics-fs-info-row {
      transform: translateY(10rem);
    }
  }
}

@if $new-control-always-on and $new-control-is-enable {
  ytmusic-app-layout[player-fullscreened][show-fullscreen-controls]:not([blyrics-dfs])>[slot="player-bar"]:before {
    opacity: 0 !important;
  }
}

.blyrics-fs-play {
  color: #ffffff;
  background: transparent;
  width: 4.5rem;
  height: 4.5rem;
  &:hover {
    background: rgba(255, 255, 255, 0.1);
  }
}

.blyrics-fs-disc:hover {
  background: rgba(255, 255, 255, 0.1);
}

.blyrics-footer {
  opacity: 0;
  filter: blur(6px);
  transition: 
  opacity var(--anim-fade-duration-alt) var(--anim-fade-timing),
  filter 1s var(--anim-fade-timing);
  &:hover {
    opacity: 1;
    filter: none;
    transition: opacity var(--anim-fade-duration) var(--anim-fade-timing);
  }
}

.blyrics-footer__discord,
.autoscroll-resume-button,
.blyrics-footer__container {
  background: var(--btn-color);
  border: var(--ui-border);
  backdrop-filter: blur(var(--ui-blur));
}
.autoscroll-resume-button {
  border-radius: var(--radius-btn);
}
.blyrics-footer__container {
  border-radius: var(--radius-btn-alt);
}
.blyrics-footer__discord > img {
  filter: brightness(1.5);
}
#betterLyricsFooterLink span {
  color: var(--icon) !important;
  opacity: 1 !important;
}
.blyrics-dock__offset-value {
  font-family: var(--font-family);
}

/* ========================== LYRICS ========================== */
.blyrics--line {
  transition: filter 0.8s ease-in-out, opacity 0.6s ease;
  filter: if(map-get($lyrics-blur-lines, previous), blur($lyrics-blur-amount), none);
  opacity: 0.4;
  &:hover {
    filter: none !important;
    opacity: 1 !important;
  }
}
.blyrics-container[data-sync='none'] .blyrics--line {
  opacity: 1;
  filter: none;
  transition: filter 0.35s ease-in-out, opacity 0.2s ease;
}
.blyrics-container .blyrics--active ~ .blyrics--line {
  opacity: 1;
  filter: if(map-get($lyrics-blur-lines, upcoming), blur($lyrics-blur-amount), none);
}
.blyrics-container .blyrics--line.blyrics--pre-animating {
  filter: if(map-get($lyrics-blur-lines, current), blur($lyrics-blur-amount), none);
  opacity: 1;
}
.blyrics--line.blyrics--active.blyrics--animating {
  filter: if(map-get($lyrics-blur-lines, current), blur($lyrics-blur-amount), none);
  opacity: 1;
  transition-delay: 0s;
}
.blyrics-container.blyrics-user-scrolling .blyrics--line {
  opacity: 1;
  filter: none;
  transition: filter 0.35s ease-in-out, opacity 0.2s ease;
}

@keyframes blyrics-glow {
  0% {
    filter: drop-shadow(0 0 1.2rem var(--blyrics-glow-color));
  }
  to {
    filter: drop-shadow(0 0 0rem var(--blyrics-glow-color));
  }
}
